---
import { TrackPill } from "@/components/demo/TrackPill";
import { bloom, type TrackName, warm, type WarmName } from "@/lib/gradients";

/**
 * The app window as it appears on the marketing page: chrome strip, a grid of
 * photo frames, and the track pill floating over the grid.
 *
 * The grid is decorative — the surrounding copy carries the meaning — so it is
 * hidden from assistive technology rather than announcing a wall of blanks.
 *
 * `pillRow` is 1-indexed and positions the pill on the centre line of that row
 * rather than at a fixed offset, so it stays put as the tiles resize.
 */
type Props = {
  activeTrack: TrackName;
  columns: number;
  pillRow?: number;
  tiles: WarmName[];
};

const { activeTrack, columns, pillRow = 1, tiles } = Astro.props;

/** Row gap in px. Must match the `gap-3` on the grid below. */
const GAP = 12;

const rows = Math.ceil(tiles.length / columns);

/*
 * The exact centre line of the target row.
 *
 * A plain percentage is wrong here: the gaps are fixed pixels, so they are not
 * part of the proportional split. Subtracting them first gives the true row
 * height, then the gaps above the target row are added back. With two rows and
 * a 12px gap this is the difference between 75% and 75% + 3px — small, but it
 * is the difference between the pill sitting on the row and near it.
 */
const trackHeight = `(100% - ${(rows - 1) * GAP}px)`;
const pillTop = `calc(${(pillRow - 0.5) / rows} * ${trackHeight} + ${(pillRow - 1) * GAP}px)`;
---

<div
  class="relative overflow-hidden rounded-t-2xl border border-b-0 border-[rgba(43,38,33,0.10)] bg-surface shadow-[0_1px_3px_rgba(43,38,33,0.05),0_28px_64px_-24px_rgba(43,38,33,0.20)]"
>
  <div
    class="flex h-[46px] items-center border-b border-[rgba(43,38,33,0.08)] bg-[rgba(255,250,246,0.92)] px-[18px]"
  >
    <div aria-hidden="true" class="flex shrink-0 gap-2">
      <span class="size-[11px] rounded-full bg-[rgba(43,38,33,0.15)]"></span>
      <span class="size-[11px] rounded-full bg-[rgba(43,38,33,0.15)]"></span>
      <span class="size-[11px] rounded-full bg-[rgba(43,38,33,0.15)]"></span>
    </div>
  </div>

  <div class="p-[18px]">
    <div class="relative">
      <div
        aria-hidden="true"
        class="grid gap-3"
        style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr));`}
      >
        {
          tiles.map((tile) => (
            <div
              class="relative aspect-3/2 overflow-hidden rounded-[5px]"
              style={`background:${warm[tile]}`}
            >
              <div class="absolute inset-0" style={`background:${bloom}`} />
            </div>
          ))
        }
      </div>

      <div
        class="pointer-events-none absolute inset-x-0 flex -translate-y-1/2 justify-center"
        style={`top:${pillTop}`}
      >
        <TrackPill active={activeTrack} />
      </div>
    </div>
  </div>
</div>
