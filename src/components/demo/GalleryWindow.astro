---
import { PhotoFrame } from "@/components/demo/PhotoFrame";
import { TrackPill } from "@/components/demo/TrackPill";
import { WindowBar } from "@/components/demo/WindowBar";
import { type ToneName, tones, type TrackName } from "@/lib/tones";

/**
 * The app window as it appears on the marketing page: chrome strip, a grid of
 * photo frames, and the track pill floating over the grid.
 *
 * Frames render through `PhotoFrame` rather than repeating its markup here.
 * An earlier version inlined the chrome, and the two promptly drifted — the
 * rating pips were restyled in one place and not the other. PhotoFrame is
 * server-rendered here; it needs no hydration because nothing in the hero
 * moves.
 *
 * The grid is decorative — the surrounding copy carries the meaning — so it is
 * hidden from assistive technology rather than announcing a wall of blanks.
 *
 * `pillRow` is 1-indexed and positions the pill on the centre line of that row
 * rather than at a fixed offset, so it stays put as the tiles resize.
 */
type Frame = { rating: number | null; tone: ToneName; track: TrackName };

type Props = {
  activeTrack: TrackName;
  columns: number;
  frames: Frame[];
  pillRow?: number;
  /** Frame numbers count up from here. */
  startNumber?: number;
};

const { activeTrack, columns, frames, pillRow = 1, startNumber = 4821 } = Astro.props;

/** Row gap in px. Must match the `gap-3` on the grid below. */
const GAP = 12;

const rows = Math.ceil(frames.length / columns);

/*
 * The exact centre line of the target row.
 *
 * A plain percentage is wrong here: the gaps are fixed pixels, so they are not
 * part of the proportional split. Subtracting them first gives the true row
 * height, then the gaps above the target row are added back.
 */
const trackHeight = `(100% - ${(rows - 1) * GAP}px)`;
const pillTop = `calc(${(pillRow - 0.5) / rows} * ${trackHeight} + ${(pillRow - 1) * GAP}px)`;
---

<div
  class="relative overflow-hidden rounded-t-2xl border border-b-0 border-[rgba(43,38,33,0.10)] bg-white shadow-[0_1px_3px_rgba(43,38,33,0.05),0_28px_64px_-24px_rgba(43,38,33,0.20)]"
>
  <WindowBar />

  <div class="p-[18px]">
    <div class="relative">
      <div
        aria-hidden="true"
        class="grid gap-3"
        style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr));`}
      >
        {
          frames.map((frame, index) => (
            <PhotoFrame
              className="aspect-3/2"
              frameNumber={startNumber + index}
              rating={frame.rating}
              tone={tones[frame.tone]}
              track={frame.track}
            />
          ))
        }
      </div>

      <div
        class="pointer-events-none absolute inset-x-0 flex -translate-y-1/2 justify-center"
        style={`top:${pillTop}`}
      >
        <TrackPill active={activeTrack} />
      </div>
    </div>
  </div>
</div>
