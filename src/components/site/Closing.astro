---
import { siteConfig } from "@/lib/config";
import { closing } from "@/lib/copy";

/**
 * The closing section: the page's one call to action, a link to the checkout
 * styled as the bar's Get Qeepa at a larger size — the track pill's active
 * segment, peach-accent with its APCA-checked brown label, turning ink on
 * hover. It fades up as a `[data-reveal]` after the copy's lines rise, and is
 * simply there without JavaScript or motion.
 *
 * Type only. The plan once placed a blank peach square here as a stand-in for
 * the app icon, but no icon exists and PRODUCT.md forbids inventing one, and a
 * soft-shadowed rectangle standing in for content is exactly the placeholder
 * the craft floor bans. Calm comes from the space, not from an ornament.
 *
 * The screenshot carousel follows, and the gap down to it matches the one
 * beneath the carousel to the footer — deeper than the closing's top, so the
 * screenshots read as their own beat rather than a footnote to the copy.
 *
 * `id` is also the floating bar's cue to return to its browse state here: the
 * closing is not a feature, so the bar should not go on naming the last one.
 */
type Props = { id: string };

const { id } = Astro.props;
---

<section
  data-line-reveal
  class="mx-auto max-w-[1440px] scroll-mt-24 px-6 pt-32 pb-40 text-center lg:px-[120px] lg:pt-44 lg:pb-64"
  id={id}
>
  <h2
    class="mx-auto max-w-[900px] font-sans text-[clamp(32px,3.6vw,48px)] leading-[1.1] font-bold tracking-[-0.032em] text-balance text-text-primary"
    data-lines
  >
    {closing.heading}
  </h2>
  <p
    class="mx-auto mt-6 max-w-[620px] font-sans text-[17px] leading-[1.65] text-pretty text-text-secondary"
    data-lines
  >
    {closing.body}
  </p>
  <div class="mt-10" data-reveal style="--reveal-index: 2">
    <a
      class="inline-flex items-center rounded-full bg-primary px-6 py-3 text-[15px] leading-5 font-medium text-[#5C300C] transition-colors duration-(--motion-quick) ease-(--ease-standard) hover:text-text-primary focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none motion-reduce:transition-none"
      href={siteConfig.links.checkout}
    >
      {closing.cta}
    </a>
  </div>
</section>
