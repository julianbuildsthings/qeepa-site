---
/**
 * One feature per row, never a card grid. Roughly two-thirds visual to
 * one-third copy, alternating orientation down the page.
 *
 * `heading` and `subheading` form a two-tier heading — the feature name set
 * large, with the sentence beneath it. The subheading is never rendered as a
 * small label above the heading; a kicker is banned on this page.
 *
 * Below `xl` the row stacks to one column with the visual always first,
 * regardless of `reversed`: alternation is a desktop rhythm, and on a phone it
 * would just make some rows read copy-first and others visual-first at random.
 *
 * The split engages at `xl`, not `lg`. At 1024 the copy column came out 287px
 * — about 34 characters — which no subheading survives; the row is better
 * stacked and full width until there is room for two real columns.
 */
type Props = {
  body: string;
  heading: string;
  id: string;
  reversed?: boolean;
  subheading: string;
};

const { body, heading, id, reversed = false, subheading } = Astro.props;
---

{/*
  The wide column follows the visual, not the position — so a reversed row
  swaps the template rather than just reordering the children. Reordering alone
  handed the visual the one-third column and the copy the two-thirds one.
*/}
<section
  class:list={[
    "mx-auto grid max-w-[1440px] scroll-mt-24 items-center gap-12 px-6 py-20 lg:gap-20 lg:px-[120px] lg:py-28",
    reversed
      ? "xl:grid-cols-[minmax(0,1fr)_minmax(0,1.45fr)]"
      : "xl:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)]",
  ]}
  id={id}
>
  {/* Revealed once on entry, the visual first and the copy one stagger step
  behind it — see the reveal rules in global.css. */}
  <div
    class:list={["order-1", reversed ? "xl:order-2" : "xl:order-1"]}
    data-reveal
    style="--reveal-index: 0"
  >
    <slot />
  </div>

  <div
    class:list={["order-2", reversed ? "xl:order-1" : "xl:order-2"]}
    data-reveal
    style="--reveal-index: 1"
  >
    <h2
      class="font-sans text-[clamp(26px,2.4vw,34px)] leading-[1.12] font-bold tracking-[-0.03em] text-text-primary"
    >
      {heading}
    </h2>
    <p
      class="mt-3 font-sans text-[clamp(17px,1.4vw,20px)] leading-[1.38] tracking-[-0.014em] text-balance text-text-primary"
    >
      {subheading}
    </p>
    <p class="mt-5 font-sans text-[15px] leading-[1.7] text-pretty text-text-secondary">
      {body}
    </p>
  </div>
</section>
