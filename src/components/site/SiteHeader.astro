---
import { siteConfig } from "@/lib/config";
---

<header class="border-b border-[rgba(43,38,33,0.09)]">
  <div class="mx-auto flex h-22 max-w-[1440px] items-center px-6 lg:px-[120px]">
    <a
      class="rounded-sm font-serif text-[24px] leading-none font-semibold tracking-[-0.015em] text-text-primary focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      href="/"
      translate="no">{siteConfig.name}.</a
    >
  </div>
</header>
