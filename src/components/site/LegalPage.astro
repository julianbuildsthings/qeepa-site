---
import FloatingBar from "@/components/site/FloatingBar.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/lib/config";
import { totalPageTiles } from "@/lib/tiles";

/**
 * Shell for the legal routes the footer links to. These exist so the footer has
 * no dead ends; the bodies are deliberately honest placeholders rather than
 * invented legal text, which would be worse than an obviously unfinished page.
 */
type Props = { heading: string; title: string };

const { heading, title } = Astro.props;
---

<BaseLayout title={`${heading} — ${siteConfig.name}`} description={title}>
  <FloatingBar photoCount={totalPageTiles} />
  <main class="mx-auto min-h-[60svh] max-w-[1440px] px-6 pt-20 pb-24 lg:px-[120px]" id="main">
    <h1
      class="font-sans text-[clamp(26px,2.6vw,36px)] leading-[1.12] font-bold tracking-[-0.03em] text-text-primary"
    >
      {heading}
    </h1>
    <p class="mt-5 max-w-[560px] font-sans text-[15px] leading-[1.7] text-text-secondary">
      <slot />
    </p>
  </main>
  <SiteFooter />
</BaseLayout>
