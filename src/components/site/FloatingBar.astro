---
import { siteConfig } from "@/lib/config";

/**
 * Adapted from the app's own `floating-bar.tsx`, matching its surface values
 * exactly: 48px tall, fully rounded, `#FFFFFFF5` ground, `gap-2.5`, and the
 * same `0px 10px 30px rgba(43,38,33,0.14)` shadow.
 *
 * The copy follows the app's browse state literally — an Erode 17px title
 * followed immediately by a 13px secondary label, both ranged left, the way a
 * shoot name is followed by its count. The site's title is the wordmark and the
 * secondary label is the real number of photo frames on the page.
 *
 * Weight is the app's `font-medium`, not bold: at 17px in a 48px bar, Erode
 * Bold reads clumsy where Medium reads considered.
 *
 * Two deliberate departures. It is `sticky` rather than the app's `absolute`,
 * because the app's bar lives in a fixed-height window and this one has to
 * survive a scrolling page. And it aligns to the page's 120px content rail
 * rather than the app's 32px window inset, so the bar and the headline share
 * one left edge.
 *
 * The resting offset (`mt-*`) is margin rather than padding on purpose: margin
 * sits outside the sticky box, so the bar starts low and rises to `top-4` as
 * you scroll. Padding would travel with it and it would never rise. That offset
 * is kept equal to the hero's own top padding — that equality is what centres
 * the bar between the top of the viewport and the first line of copy.
 *
 * The app's selection state (peach-light ground, star rating, Share) is not
 * built; v1 stays in browse state throughout.
 */
type Props = { photoCount: number };

const { photoCount } = Astro.props;
---

<div class="pointer-events-none sticky top-4 z-30 mt-8 px-6 lg:mt-14 lg:px-[120px]">
  <div class="mx-auto max-w-[1200px]">
    <div
      class="pointer-events-auto flex h-12 items-center gap-2.5 rounded-full bg-[#FFFFFFF5] px-5 shadow-[0px_10px_30px_rgba(43,38,33,0.14)]"
    >
      <a
        class="shrink-0 rounded-sm font-serif text-[17px] leading-[22px] font-medium tracking-[-0.01em] text-text-primary focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
        href="/"
        translate="no"
        >{siteConfig.name}<span class="text-raw">.</span>
      </a>

      <p class="truncate text-[13px] leading-4 text-text-secondary tabular-nums">
        {photoCount}&nbsp;photos.
      </p>
    </div>
  </div>
</div>
